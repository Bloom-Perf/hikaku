{
  "name": "@bloom-perf/hikaku",
  "version": "0.3.0",
  "description": "Lightweight Prometheus metrics analysis and regression detection for Kyara load testing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@prometheus-io/client": "0.16.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "esbuild": "0.28.2",
    "esbuild-node-externals": "2.0.0",
    "mocha": "12.0.3",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "rm -rf dist && node esbuild.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bloom-Perf/hikaku.git"
  },
  "keywords": [
    "prometheus",
    "metrics",
    "baseline",
    "regression",
    "load-testing",
    "performance",
    "llm",
    "report"
  ],
  "author": "Bloom-perf",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Bloom-Perf/hikaku/issues"
  },
  "homepage": "https://www.npmjs.com/package/@bloom-perf/hikaku"
}
